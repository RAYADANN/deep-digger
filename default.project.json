{
    "name": "deep-digger",
    "globIgnorePaths": [
        "**/node_modules/*"
    ],
    "tree": {
        "$className": "DataModel",
        "ReplicatedStorage": {
            "$className": "ReplicatedStorage",
            "$ignoreUnknownInstances": true,
            "Packages": {
                "$path": "Packages"
            },
            "shared": {
                "$path": "src/shared"
            }
        },
        "ServerScriptService": {
            "$className": "ServerScriptService",
            "$ignoreUnknownInstances": true,
            "server": {
                "$path": "src/server"
            }
        },
        "StarterGui": {
            "$className": "StarterGui",
            "$ignoreUnknownInstances": true,
            "client": {
                "$path": "src/client"
            }
        },
        "Workspace": {
            "$className": "Workspace",
            "$ignoreUnknownInstances": true,
            "$properties": {
                "FilteringEnabled": true
            }
        }
    }
}
